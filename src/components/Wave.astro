---
const rows = Array.from({ length: 22 }, (_, row) =>
  Array.from({ length: 75 }, (_, column) => {
    const x = column * 12;
    const y = 185 + Math.sin(column * 0.095 + row * 0.12) * (32 + row * 1.7) - column * 1.6 + row * 5;
    return { x, y, opacity: 0.2 + Math.sin(column * 0.13 + row * 0.2) ** 2 * 0.65 };
  }),
);
---
<svg class="hero-wave" viewBox="0 0 900 360" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="wave-line"><stop stop-color="#333cff" stop-opacity="0"/><stop offset=".6" stop-color="#7862ff"/><stop offset="1" stop-color="#bbacff" stop-opacity=".15"/></linearGradient>
    <radialGradient id="wave-glow"><stop stop-color="#7760ff" stop-opacity=".22"/><stop offset="1" stop-color="#7760ff" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse cx="510" cy="155" rx="370" ry="135" fill="url(#wave-glow)"/>
  {rows.map((points, index) => <g>
    {index % 4 === 0 && <polyline points={points.map(p => `${p.x},${p.y}`).join(' ')} stroke="url(#wave-line)" stroke-width=".6" opacity=".65"/>}
    {points.map(p => <circle cx={p.x} cy={p.y} r={index % 4 === 0 ? 1.3 : .8} fill={index % 4 === 0 ? '#ab92ff' : '#6579ff'} opacity={p.opacity}/>)}
  </g>)}
</svg>
